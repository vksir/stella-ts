# Stella 配置示例：复制为 `.env` 并按需修改。
# Stella 只读取当前目录（server 进程工作目录）及仓库根目录下的 `.env`，不读取 pi 私有文件（如 ~/.pi/agent/auth.json）。

# —— Provider 自动发现 ——
# 配置了 key 的 provider 会在启动时自动注册，未配置的跳过。一个 key 都没有时启动会报错（除非开 STELLA_FAUX=1）。
DEEPSEEK_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
# OpenCode Go（provider id: opencode-go；模型如 opencode-go/deepseek-v4.1-flash）
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# —— 默认模型 ——
# provider/modelId 形式，缺省 deepseek/deepseek-chat。
# 注意：pi-ai 1.5.1 目录中 deepseek 的模型 id 是 deepseek-flash、deepseek-v4-pro 等，
# 若缺省模型不在目录中，Stella 会改用该 provider 的第一个模型并在启动日志中提示。
STELLA_DEFAULT_MODEL=deepseek/deepseek-chat

# —— 服务 ——
# server 监听端口（默认 7090；web 开发服务器的 /api 代理指向它）
STELLA_PORT=7090
# 数据目录：SQLite 数据库与默认工作区 data/workspace 所在目录（默认 ./data，相对 server 进程工作目录）
STELLA_DATA_DIR=./data

# —— 模型请求的 attribution（可选）——
# Stella 以自己的名义请求 provider；url 用于 OpenRouter 排行分组，缺省 http://localhost。
# STELLA_ATTRIBUTION_URL=https://your-domain.example/stella

# —— 免 key 模式 ——
# 设为 1 时使用 faux provider（固定示例回答）与内存存储，不读任何 API key、不写 SQLite。
# 用于测试与本地体验：npm 仓库根执行 `set STELLA_FAUX=1&& npm run dev` 或在 .env 中开启。
# STELLA_FAUX=1
# faux 流式速率（tokens/s）：演示/测试排队与停止时用它把回答放慢，例如 5。
# STELLA_FAUX_RATE=5

# —— 观察窗口（可选，调试用）——
# SSE view 携带的最近条目数，默认 200（范围 4–400）。调小可在短会话上验证
# 「加载更早」与断线缺口补页；调大用于长会话压测。
# STELLA_ENTRY_WINDOW=200
