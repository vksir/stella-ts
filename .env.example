# Stella 配置示例：复制为 `.env` 并按需修改。
# Stella 只读取当前目录（server 进程工作目录）及仓库根目录下的 `.env`，不读取 pi 私有文件（如 ~/.pi/agent/auth.json）。

# —— Provider 自动发现 ——
# 配置了 key 的 provider 会在启动时自动注册，未配置的跳过。一个 key 都没有时启动会报错（除非开 STELLA_FAUX=1）。
DEEPSEEK_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
# OpenCode Go（provider id: opencode-go；模型如 opencode-go/deepseek-v4.1-flash）
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# —— 默认模型 ——
# provider/modelId 形式，缺省 deepseek/deepseek-chat。
# 注意：pi-ai 1.5.1 目录中 deepseek 的模型 id 是 deepseek-flash、deepseek-v4-pro 等，
# 若缺省模型不在目录中，Stella 会改用该 provider 的第一个模型并在启动日志中提示。
STELLA_DEFAULT_MODEL=deepseek/deepseek-chat

# —— 服务 ——
# server 监听端口（默认 5810；web 开发服务器的 /api 代理指向它）
STELLA_PORT=5810
# 监听地址：默认 127.0.0.1，只有本机能连。
# 要对外（局域网、Docker 端口映射、反向代理）必须显式设成 0.0.0.0 或具体网卡地址。
# 非回环地址必须同时显式设置 STELLA_REQUIRE_HTTPS=1；否则启动会直接失败。
# TLS 请交给反向代理，Stella 自身不提供 HTTPS。
# STELLA_HOST=0.0.0.0

# —— 反向代理信任（公网部署关键）——
# 只有直连方在这个名单里，才信任 X-Forwarded-For / X-Forwarded-Proto；
# 否则头部一律当伪造忽略。默认 127.0.0.1,::1，只适用于「反代与 Stella 同机、
# Stella 只绑回环」。Docker 网桥或另一台机器上的反代必须把它的地址加进来，例如：
#   STELLA_TRUSTED_PROXY=172.16.0.0/12,127.0.0.1
# 支持精确 IP（IPv4/IPv6）与 IPv4 CIDR；IPv6 只支持精确匹配与 /128。
# 绝不要写 0.0.0.0/0（启动会拒绝）：那等于信任任何直连方伪造 XFF/XFP。
# STELLA_TRUSTED_PROXY=127.0.0.1,::1

# 强制经 HTTPS。开启后，除 /api/health 外所有 /api 请求（不只是登录）都要求
# 可信 X-Forwarded-Proto: https；直连端口无法用明文票据调用 API。
# 即使不开启，反代明确标为 http 的请求也会被拒绝（防反代配错/降级）。
# 非回环监听且未显式设置本项时，启动会直接失败；确实要在局域网用明文 HTTP
# 才显式写 STELLA_REQUIRE_HTTPS=0（自担风险）。
# STELLA_REQUIRE_HTTPS=1

# 前端构建产物目录（默认 ../web/dist，相对 server 进程 cwd）。
# 若不从 server/ 目录启动（例如容器里直接 node server/dist/main.js），必须显式指定。
# STELLA_WEB_DIST=/app/web/dist

# —— 登录密钥（准入）——
# Stella 没有用户系统，只有这一把锁：打开页面先输它。
# 至少 32 字符；留空时首次启动会自动生成一枚 43 字符密钥并写回这个 .env
# （密钥不回显，请从 .env 读取）；也可以手动生成：npm run token:gen。
# 显式配置短于 32 字符时启动会失败（它同时是票据的 HMAC 密钥）。
# 改这一行并重启，会让所有浏览器重新登录（旧票据验签失败）。
# STELLA_TOKEN=

# 数据目录：SQLite 数据库与默认工作区 data/workspace 所在目录（默认 ./data，相对 server 进程工作目录）
STELLA_DATA_DIR=./data

# —— 模型请求的 attribution（可选）——
# Stella 以自己的名义请求 provider；url 用于 OpenRouter 排行分组，缺省 http://localhost。
# STELLA_ATTRIBUTION_URL=https://your-domain.example/stella

# —— 免 key 模式 ——
# 设为 1 时使用 faux provider（固定示例回答）与内存存储，不读任何 API key、不写 SQLite。
# 用于测试与本地体验：npm 仓库根执行 `set STELLA_FAUX=1&& npm run dev` 或在 .env 中开启。
# 未配 STELLA_TOKEN 时仅限回环地址；非回环 + 未配密钥会拒绝启动。配了密钥则照常启用登录。
# STELLA_FAUX=1
# faux 流式速率（tokens/s）：演示/测试排队与停止时用它把回答放慢，例如 5。
# STELLA_FAUX_RATE=5

# —— 观察窗口（可选，调试用）——
# SSE view 携带的最近条目数，默认 200（范围 4–400）。调小可在短会话上验证
# 「加载更早」与断线缺口补页；调大用于长会话压测。
# STELLA_ENTRY_WINDOW=200
